# 后端模型配置模板
# 使用方式：复制本文件为 server/backend/.env，然后只填写 DASHSCOPE_API_KEY。
# 注意：不要把 .env 提交到 Git。

# ========== 阿里云百炼 / DashScope ==========
# 统一 AI 供应商。默认 qwen，会使用阿里云百炼 OpenAI 兼容接口。
AI_PROVIDER=qwen

# 你的阿里云百炼 API Key。文本、视觉、语音、多模态优先复用这一把密钥。
DASHSCOPE_API_KEY=请在这里填写你的阿里云百炼密钥

# 兼容旧代码的别名；如果不填，后端代码会自动回退到 DASHSCOPE_API_KEY。
# QWEN_API_KEY=请在这里填写同一个阿里云百炼密钥
# DASHSCOPE_API_KEY_TUANTUAN=请在这里填写同一个阿里云百炼密钥

# 文本对话模型：知识库问答、案例总结、审核建议、模型输出修正
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 图片/多模态理解模型：检修图片识别、现场照片分析、仪表/部件状态说明
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 向量模型：知识库检索、RAG、案例相似度匹配
EMBEDDING_MODEL=text-embedding-v4

# 语音识别：前端语音输入转文字
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1

# 图片生成/编辑，如不使用可保持默认
QWEN_IMAGE_MODEL=qwen-image-2.0

# ========== 可选：地图/定位 ==========
# AMAP_API_KEY=请在这里填写高德地图密钥
