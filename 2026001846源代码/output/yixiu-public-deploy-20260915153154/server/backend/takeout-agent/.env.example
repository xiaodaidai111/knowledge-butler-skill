# ========== 仅在后端配置即可，前端无需填写 API Key ==========
# 复制本文件为 .env，填写下面两项后重启服务即可使用。

# DeepSeek API Key
DEEPSEEK_API_KEY=你的DeepSeek_API_Key

# DeepSeek API Base URL（默认为官方地址，如需使用代理可修改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 以下为可选 ----------
# 对话模型（默认 deepseek-chat）
# DEEPSEEK_CHAT_MODEL=deepseek-chat
# 向量模型（知识库检索，默认 deepseek-embedding）
# DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
# RAG 检索条数
# RAG_TOP_K=3
# 数据库路径
# DATABASE_PATH=data/agent.db

# 跨域配置（前后端分离时使用）
# CORS_ALLOW_ORIGINS=*   # 多个域名用逗号分隔，如 https://a.com,https://b.com
# CORS_ALLOW_METHODS=GET,POST,OPTIONS
# CORS_ALLOW_HEADERS=Content-Type, X-Api-Key, X-Base-Url, X-Chat-Model, X-Embedding-Model

# 调试开关（生产环境建议关闭）
# SHOW_DEBUG_INFO=0
